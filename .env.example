# Firebase Web Configuration (Get these from Firebase Console -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push Certificate Key Pair (Firebase Console -> Cloud Messaging -> Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# Landing Hero Video URL (OPTIONAL)
# Defaults to /video/hero.mp4 (self-hosted in public/video/).
# Set this only if you want to serve the video from a CDN instead.
# VITE_LANDING_VIDEO_URL=https://your-cdn.example.com/hero.mp4
